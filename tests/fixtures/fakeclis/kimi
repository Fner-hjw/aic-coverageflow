#!/usr/bin/env python3
"""Fake `kimi` CLI for offline backend tests (stream A3).

FAKE_KIMI_MODE = headless(default): --help advertises "-p, --prompt"
                 limited          : --help has no headless flags (degrade path)
Accepts: kimi --help | kimi -p PROMPT   (plain text on stdout)
Same FAKE_BEHAVIOR protocol as the fake claude for ok/fail/garbage/sleep.
"""
import json
import os
import sys
import time

argv_log = os.environ.get("FAKE_ARGV_LOG")
if argv_log:
    with open(argv_log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(sys.argv) + "\n")

mode = os.environ.get("FAKE_KIMI_MODE", "headless")

if "--help" in sys.argv:
    if mode == "limited":
        print("Kimi CLI - interactive chat companion")
        print("Usage: kimi            start interactive session")
        print("       kimi love       say something nice")
    else:
        print("Kimi CLI")
        print("Usage: kimi            start interactive session")
        print("       kimi -p, --prompt PROMPT   run a headless prompt, print to stdout")
        print("       kimi --help     show this help")
    sys.exit(0)

behavior = os.environ.get("FAKE_BEHAVIOR", "ok")
prompt = ""
if "-p" in sys.argv:
    prompt = sys.argv[sys.argv.index("-p") + 1]
elif "--prompt" in sys.argv:
    prompt = sys.argv[sys.argv.index("--prompt") + 1]

if behavior == "sleep":
    time.sleep(float(os.environ.get("FAKE_SLEEP_SECONDS", "10")))
if behavior == "fail":
    sys.stderr.write("kimi: login expired\n")
    sys.exit(4)
if behavior == "garbage":
    print("pong! (not json)")
    sys.exit(0)

result_text = os.environ.get(
    "FAKE_RESULT_TEXT", '{"schematic": "good", "trace": "demonstration"}'
)
print(result_text)
