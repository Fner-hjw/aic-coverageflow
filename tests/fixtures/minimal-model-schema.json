{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "minimal facts.json schema fixture (stream A2 tests only)",
  "type": "object",
  "required": ["role", "request_id", "candidate_id", "facts"],
  "properties": {
    "role": {"type": "string", "enum": ["extractor"]},
    "request_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "period", "value", "citation"],
        "properties": {
          "field": {"type": "string"},
          "period": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "citation": {
            "type": "object",
            "required": ["doc_id", "slice_id", "anchor", "locator"],
            "properties": {
              "doc_id": {"type": "string"},
              "slice_id": {"type": "string"},
              "anchor": {"type": "string"},
              "locator": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
