{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "facts.json — extractor artifact (contracts state-and-artifacts §5)",
  "description": "The wire format the extractor role must emit. references/model-schema.json is the field catalogue (canonical field names, units, period labels); this file is the JSON Schema the facts_schema gate validates against.",
  "type": "object",
  "required": [
    "role",
    "request_id",
    "candidate_id",
    "facts",
    "missing",
    "notes",
    "conformance",
    "prompt_version"
  ],
  "properties": {
    "role": {"type": "string", "enum": ["extractor"]},
    "request_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": ["string", "null"]},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "period", "value", "unit", "confidence", "citation"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "period": {"type": "string", "minLength": 4},
          "value": {"type": "number"},
          "unit": {
            "type": "string",
            "enum": ["USDmm", "USD", "shares_mm", "ratio"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "citation": {
            "type": "object",
            "required": ["doc_id", "slice_id", "anchor", "locator"],
            "properties": {
              "doc_id": {"type": "string", "minLength": 1},
              "slice_id": {"type": "string", "minLength": 1},
              "anchor": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "conformance": {"type": "string", "enum": ["schema 1.0"]},
    "prompt_version": {"type": "string", "minLength": 1}
  }
}
